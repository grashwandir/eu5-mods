colonial_governor = {
	audio_tier = 2
	is_foreign = no
	pop_type = nobles
	max_levels = 1
	important_for_UI = yes

	employment_size = large_noble_employment

	category = government_category

	rural_settlement = no
	town = yes
	city = yes
	megalopolis = yes

	allow = {
		trigger_if = {
			limit = {
				scope:actor = {
					modifier:num_naval_governors <= 0
				}
			}
			custom_tooltip = {
				text = no_naval_governor_tt
				always = no
			}
		}
		trigger_else = {
			custom_tooltip = {
				text = naval_governor_tt
				scope:actor = {
					total_building_levels_including_construction:naval_governor < modifier:num_naval_governors
				}
			}
		}
		owner = scope:actor #not in subjects
	}

	location_potential = {
		NOT = { is_connected_to_through_realm = owner.capital }
		is_overseas_for_owner = yes
		is_port = yes
	}

	remove_if = {
		location = { is_connected_to_through_realm = owner.capital }
	}

	expensive = yes

	automation_build_allowed = no
	ai_forbid_shutdown = yes
	forbidden_for_estates = yes
	important_for_AI = no
	
	build_time = government_build_time

	unique_production_methods = {
		colonial_governor_maintenance = {
			tools = 1
			masonry = 1
			weaponry = 0.5
			paper = 3
			books = 1
			goods_gold = 1
			furniture = 2
			naval_supplies = 0.5
			fine_cloth = 0.5

			category = building_maintenance
		}
	}
	
	construction_demand = local_governor_construction

	modifier = {
		local_proximity_source = 80
		local_migration_attraction = 1.0
		local_population_growth = 0.01
		
		harbor_suitability = 0.1
	}
}
