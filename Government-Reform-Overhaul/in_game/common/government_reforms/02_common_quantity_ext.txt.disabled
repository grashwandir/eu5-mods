REPLACE:mass_levy_system = {
	age = age_4_reformation
	
	allow = {
		NOT = {	has_reform = government_reform:militarized_country }
	}

	societal_values = {
		quantity_focus
	}

	country_modifier = {
		monthly_towards_quantity = societal_value_large_monthly_move
		global_manpower_modifier = 0.1
	}

	years = 2
}

REPLACE:military_allotment = {
	age = age_4_reformation
	
	allow = {
		NOT = {	has_reform = government_reform:militarized_country }
	}

	societal_values = {
		quantity_focus
	}
	
	country_modifier = {
		monthly_towards_free_subjects = societal_value_monthly_move
		global_soldiers_desired_pop_scaled = 0.1
		regiment_reinforcement_speed = 0.25
		peasants_estate_max_tax = -0.05
	}

	years = 2
}

militarized_country = {
	age = age_4_reformation
	
	icon = mass_levy_system
	
	allow = {
		NOT = {	has_reform = government_reform:mass_levy_system }
		NOT = {	has_reform = government_reform:military_allotment }
	}

	societal_values = {
		quantity_focus
	}
	
	country_modifier = {
		# mass levy
		monthly_towards_quantity = societal_value_large_monthly_move
		global_manpower_modifier = 0.1
		
		# partial military allotment
		monthly_towards_free_subjects = societal_value_minor_monthly_move
		global_soldiers_desired_pop_scaled = 0.1
		regiment_reinforcement_speed = 0.20
		peasants_estate_max_tax = -0.05
	}

	years = 2
}

